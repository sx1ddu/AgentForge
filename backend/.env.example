# ==============================================================================
# AGENTFORGE — BACKEND UNIFIED ENVIRONMENT TEMPLATE
# ==============================================================================

# Core Ports
GATEWAY_PORT=8000
AUTH_PORT=8001
CHAT_PORT=8002
AGENT_PORT=8003
BILLING_PORT=8004

# Service URLs (for Gateway and Inter-service communication)
AUTH_SERVICE=http://localhost:8001
CHAT_SERVICE=http://localhost:8002
AGENT_SERVICE=http://localhost:8003
BILLING_SERVICE=http://localhost:8004
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Shared Database & Cache
MONGODB_URI=mongodb://localhost:27017/agentforge
REDIS_URL=redis://localhost:6379

# Internal Service-to-Service Secret (Secures /update-plan and /deduct-credits)
INTERNAL_SERVICE_KEY=your_random_secure_internal_service_secret_here

# Firebase Admin SDK (Service Account credentials for verifying Google Auth)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# AI Model Providers
# 1. Groq (Primary ultra-fast LLM provider)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini (Multimodal Vision and Embeddings)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_VISION_MODEL=gemini-1.5-flash

# 3. OpenRouter / DeepSeek (Optional for coding reasoning)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat

# 4. Tavily (Real-time web search agent)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# 5. Qdrant (Vector database for PDF RAG)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# AWS S3 Storage (For generated PDFs, PPTs, and generated images)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_BUCKET_NAME=your-agentforge-artifacts-bucket

# Stripe Payments & Webhooks
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret_here
